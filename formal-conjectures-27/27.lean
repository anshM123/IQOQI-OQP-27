-- A long kernel evaluation, checked synchronously (one at a time) without a heartbeat limit.
set_option maxHeartbeats 0 in
set_option Elab.async false in
/-- Stage 1: the literal table is the table computed by the checker. -/
@[category API, AMS 15 81]
theorem uTable20 : cert20.uTable = uLit20 := qiTableEqb_eq (by decide +kernel)

-- A long kernel evaluation, checked synchronously (one at a time) without a heartbeat limit.
set_option maxHeartbeats 0 in
set_option Elab.async false in
/-- Stage 2: the rest of the check passes on the literal table. -/
@[category API, AMS 15 81]
theorem cert20_checkU : cert20.fullCheckU uLit20 = true := by decide +kernel

/-- The complete check of `cert20` passes. -/
@[category API, AMS 15 81]
theorem cert20_check : cert20.fullCheck = true :=
  cert20.fullCheck_of_fullCheckU uLit20 uTable20 cert20_checkU

/-- **CONE_20**, checked by the Lean kernel. -/
@[category API, AMS 15 81]
theorem coneCert_20 : ConeCert 20 := cert20.fullCheck_sound cert20_check

end OpenQuantumProblem27

